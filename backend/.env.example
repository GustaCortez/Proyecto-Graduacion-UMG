# Copie este archivo como .env y complete los valores reales.
# El archivo .env NUNCA debe subirse al repositorio.

# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------
PORT=3001

# development | production | test. Render lo fija en production; en local puede
# omitirse. Con test se silencia el log HTTP (lo usan las pruebas).
NODE_ENV=development

# Unico origen del frontend permitido por CORS (protocolo + dominio, sin barra
# final). En produccion es la URL de Vercel, por ejemplo
# https://solicitudes-muni.vercel.app
CORS_ORIGIN=http://localhost:3000

# Numero de proxies inversos delante del servidor, para que la IP real llegue a
# auditoria y al limitador de intentos de login. Render pone uno: TRUST_PROXY=1.
# En local, 0.
TRUST_PROXY=0

# Carpeta donde se guardan fotos y documentos adjuntos.
# Si se omite, se usa backend/uploads. En Render debe apuntar a un disco
# persistente (por ejemplo /var/data/uploads); el sistema de archivos del
# servicio se borra en cada despliegue.
# UPLOADS_DIR=/var/data/uploads

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Opcion A (nube: Neon, Render, Railway): una sola cadena de conexion. Tiene
# prioridad sobre las variables sueltas. Neon la entrega ya con ?sslmode=require.
# DATABASE_URL=postgresql://usuario:clave@ep-xxxx.us-east-2.aws.neon.tech/municipalidad_rrhh?sslmode=require

# Con DATABASE_URL el certificado TLS del servidor SE VERIFICA. Solo si el
# proveedor usa un certificado propio que Node no reconoce, ponga
# DB_SSL_INSECURE=1 para aceptarlo sin verificar (menos seguro; evitelo).
# DB_SSL_INSECURE=1

# Opcion B (desarrollo local): variables sueltas, sin TLS.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=municipalidad_rrhh
DB_USER=postgres
DB_PASSWORD=su_password_de_postgres

# Forzar o apagar TLS a mano: DB_SSL=true lo activa con variables sueltas;
# DB_SSL=false lo apaga incluso con DATABASE_URL (por ejemplo tras un tunel).
# DB_SSL=true

# ---------------------------------------------------------------------------
# Sesiones
# ---------------------------------------------------------------------------
# Firma de los tokens.
# Genere uno aleatorio, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cadena_larga_y_aleatoria_no_usar_esta

# Duración del token de acceso. Es corto a propósito: si se filtra, sirve poco
# tiempo. El frontend lo renueva solo con el refresh token.
ACCESS_TOKEN_EXPIRES_IN=15m

# Días de validez del refresh token (rota en cada uso).
REFRESH_TOKEN_DAYS=7

# ---------------------------------------------------------------------------
# Almacenamiento de archivos (fotos y documentos adjuntos)
# ---------------------------------------------------------------------------
# Sin estas variables los archivos van a UPLOADS_DIR (disco local). En Render el
# disco es efimero: defina un bucket S3 compatible (Cloudflare R2, Supabase
# Storage, Backblaze B2 o AWS S3). Basta con STORAGE_S3_BUCKET para activarlo.
# STORAGE_S3_BUCKET=rrhh-jalapa
# STORAGE_S3_ENDPOINT=https://<cuenta>.r2.cloudflarestorage.com
# STORAGE_S3_REGION=auto
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=
# 1 para Neon Object Storage, Supabase Storage o MinIO (URLs endpoint/bucket/clave).
# STORAGE_S3_FORCE_PATH_STYLE=
