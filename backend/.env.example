# Copie este archivo como .env y complete los valores reales.
# El archivo .env NUNCA debe subirse al repositorio.

# Servidor
PORT=3001

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=municipalidad_rrhh
DB_USER=postgres
DB_PASSWORD=su_password_de_postgres

# Firma de los tokens.
# Genere uno aleatorio, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cadena_larga_y_aleatoria_no_usar_esta

# Duración del token de acceso. Es corto a propósito: si se filtra, sirve poco
# tiempo. El frontend lo renueva solo con el refresh token.
ACCESS_TOKEN_EXPIRES_IN=15m

# Días de validez del refresh token (rota en cada uso).
REFRESH_TOKEN_DAYS=7

# Compatibilidad con la versión anterior; ya no se usa para firmar.
JWT_EXPIRES_IN=8h
